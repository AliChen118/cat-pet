# 构建产物与依赖（可重新生成，不入库）
dist/
_dist/
node_modules/
app/node_modules/

# 源素材体积大、可重新生成，不入库
assets-src/raw/
assets-src/sprites-poses/
assets-src/previews/
assets-src/style-options/

# 本地产物与归档
# archive/ 下含 shots/（验收截图）、audio-history/（音频报表）、dist-legacy/（旧产物）
archive/
_backup/
_purge.py
.workbuddy/

# Python 脚本运行残留
__pycache__/
*.pyc

# 日志与临时文件
*.log
npm-debug.log*

# 编辑器/系统
.vscode/
Thumbs.db
desktop.ini
